+      ).map((x) => x.amount)
+    );
+    return all.length ? Math.min(...all) : null;
+  };
+  // `inventory_quantity` vine null din lista de produse a adminului, deci
+  // stocul disponibil se calculează din nivelurile de inventar: stocat minus
+  // rezervat, împărțit la cantitatea cerută per variantă.
+  const stockOf = (p) => {
+    const vs = p.variants || [];
+    if (vs.some((v) => v.manage_inventory === false)) return "nelimitat";
+    let total = 0;
+    let known = false;
+    for (const v of vs) {
+      const items = v.inventory_items || [];
+      if (!items.length) continue;
+      known = true;
+      total += Math.max(0, Math.min(...items.map((it) => {
+        const lv = it.inventory?.location_levels || [];
+        const free = lv.reduce((s, l) => s + (l.stocked_quantity || 0) - (l.reserved_quantity || 0), 0);
+        return Math.floor(free / (it.required_quantity || 1));
+      })));
+    }
+    return known ? total : "\u2014";
+  };
+  return [
+    {
+      id: "product",
+      header: () => "Produs",
+      cell: ({ row }) => h(
+        "div",
+        { className: "flex " + productMinWidth + " items-center gap-x-3 py-2" },
+        h("div", { className: "w-fit flex-shrink-0" }, h(Thumb, { src: row.original.thumbnail })),
+        h("span", { title: row.original.title, className: "line-clamp-2 whitespace-normal" }, row.original.title)
+      )
+    },
+    {
+      id: "obd_price",
+      header: () => "Preț",
+      cell: ({ row }) => h("span", { className: "whitespace-nowrap" }, money(priceOf(row.original)))
+    },
+    {
+      id: "obd_stock",
+      header: () => "Stoc",
+      cell: ({ row }) => {
+        const s = stockOf(row.original);
+        return h("span", { className: s === 0 ? "text-ui-fg-error" : "" }, String(s));
+      }
+    },
+    ...keep
+  ];
+};
